GUI_TIMEOUT = 120  # s que o diálogo espera antes de negar. Falha fechada.

# Resistência relativa dos portões (README "Portões de aprovação"). Serve para
# recusar sessão aberta por portão mais fraco que o vigente agora.
GATE_STRENGTH = {"tty": 1, "gui": 2, "touchid": 3}

DEFAULT_CONFIG = {
    # Sem bloco "github" desde 18/ago/2026: o alvo saiu do broker em favor de
    # dois PATs fine-grained de vida longa (`github-pat` no Mac, `github-pat-vm`
    # no container/VM). GCP e Salesforce continuam cunhados aqui.
    "gcp": {
