# O Salesforce exige que o `exp` do JWT esteja numa janela curta a partir de
# agora; 3 min é folgado o suficiente para tolerar deriva de relógio e curto o
# suficiente para a asserção não ser reutilizável se for capturada.
SF_ASSERTION_TTL = 180

