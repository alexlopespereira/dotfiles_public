+// noiseOnStderr is what a wrapper around gh writes on every invocation. This
+// exact line comes from Automic Vault's gh build, but a corporate proxy or any
+// approval gate does the same thing. gh exits 0; the notice is an audit record,
+// not a refusal.
+const noiseOnStderr = "automic vault: human approval required\n"
+
+func TestGetChecksIgnoresWrapperNoiseOnStderr(t *testing.T) {
+	t.Parallel()
+
+	host := New(githubTestCmdFactory(map[string]githubTestResponse{
+		"gh pr checks 123 --repo test/repo --json name,state,bucket,completedAt": {
+			stdout: `[{"name":"build","state":"SUCCESS","bucket":"pass"}]` + "\n",
+			stderr: noiseOnStderr,
+		},
+	}), nil, "", "test/repo")
+
+	checks, err := host.GetChecks(context.Background(), &scm.PR{Number: "123"})
+	if err != nil {
+		t.Fatalf("GetChecks() error = %v, want stderr to be ignored", err)
+	}
+	if len(checks) != 1 || checks[0].Name != "build" {
+		t.Fatalf("checks = %+v, want single build check", checks)
+	}
+}
+
+func TestFindPRIgnoresWrapperNoiseOnStderr(t *testing.T) {
+	t.Parallel()
+
+	host := New(githubTestCmdFactory(map[string]githubTestResponse{
+		"gh pr list --head feature/refactor --base main --state open --json number,url": {
+			stdout: `[{"number":42,"url":"https://github.com/test/repo/pull/42"}]` + "\n",
+			stderr: noiseOnStderr,
+		},
+	}), nil, "", "")
+
+	pr, err := host.FindPR(context.Background(), "feature/refactor", "main")
+	if err != nil {
+		t.Fatalf("FindPR() error = %v", err)
+	}
+	// Folding stderr in does not error here — json.Unmarshal fails and FindPR
+	// reports "no PR". The pipeline then opens a second PR for a branch that
+	// already has one, which is why silence is the dangerous outcome.
+	if pr == nil {
+		t.Fatal("FindPR() = nil, want the existing PR found despite stderr noise")
+	}
+	if pr.Number != "42" {
+		t.Fatalf("FindPR() number = %q, want 42", pr.Number)
+	}
+}
+
+func TestCreatePRIgnoresWrapperNoiseOnStderr(t *testing.T) {
+	t.Parallel()
+
+	host := New(githubTestCmdFactory(map[string]githubTestResponse{
+		"gh pr create --head feature/refactor --base main --repo test/repo --title t --body-file -": {
+			stdout:    "https://github.com/test/repo/pull/42\n",
+			stderr:    noiseOnStderr,
+			wantStdin: "b",
+		},
+	}), nil, "", "test/repo")
+
+	pr, err := host.CreatePR(context.Background(), "feature/refactor", "main", scm.PRContent{Title: "t", Body: "b"})
+	if err != nil {
+		t.Fatalf("CreatePR() error = %v", err)
+	}
+	// The URL is the output, so contamination lands straight in pr.URL and
+	// every later `gh pr view <url>` fails on a URL that was never valid.
+	if pr.URL != "https://github.com/test/repo/pull/42" {
+		t.Fatalf("CreatePR() URL = %q, want the URL alone", pr.URL)
+	}
+}
+
+func TestGetChecksStillReportsNoChecks(t *testing.T) {
+	t.Parallel()
+
+	// gh writes "no checks reported" to stderr and exits non-zero. Reading it
+	// off stdout only worked because the two streams were merged; the
+	// stderr-aware path has to keep this case working.
+	host := New(githubTestCmdFactory(map[string]githubTestResponse{
+		"gh pr checks 123 --repo test/repo --json name,state,bucket,completedAt": {
+			stderr: "no checks reported on the 'feature' branch\n",
+			code:   1,
+		},
+	}), nil, "", "test/repo")
+
+	checks, err := host.GetChecks(context.Background(), &scm.PR{Number: "123"})
+	if err != nil {
+		t.Fatalf("GetChecks() error = %v, want no-checks treated as empty", err)
+	}
+	if len(checks) != 0 {
+		t.Fatalf("checks = %+v, want none", checks)
+	}
+}
