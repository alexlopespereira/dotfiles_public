+// ghOutput runs cmd and returns its stdout ALONE, plus a human-readable detail
+// string for error messages.
+//
+// stdout must stay clean because callers below either json.Unmarshal it or take
+// the trimmed bytes as the value itself. gh is frequently reached through a
+// wrapper — a secret broker, a corporate proxy, an approval gate — and those
+// wrappers announce themselves on stderr on every single invocation. Folding
+// stderr into stdout puts that notice in front of the JSON, so the parse fails
+// on a run where gh itself succeeded and exited 0.
+//
+// The detail string keeps the old diagnostics: stderr when the command failed
+// (that is where gh writes its errors), stdout otherwise.
+func ghOutput(cmd *exec.Cmd) (stdout []byte, detail string, err error) {
+	out, err := cmd.Output()
+	detail = strings.TrimSpace(string(out))
+	var exitErr *exec.ExitError
+	if errors.As(err, &exitErr) {
+		if stderr := strings.TrimSpace(string(exitErr.Stderr)); stderr != "" {
+			detail = stderr
+		}
+	}
+	return out, detail, err
+}
