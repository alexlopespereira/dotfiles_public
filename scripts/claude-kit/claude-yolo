# claude-yolo — atalho para `claude --dangerously-skip-permissions` (modo YOLO).
#
# O que faz: invoca o CLI `claude` com a flag --dangerously-skip-permissions
#   prefixada, repassando todos os argumentos extras na ordem ("$@"). Evita
#   digitar a flag (e os prompts de permissão por tool) em sessões onde você
#   confia no escopo.
#
# Quando usar: trabalho interativo em sandbox/VM ou repo onde aprovar cada tool
#   call é overhead puro. NÃO use onde uma ação destrutiva acidental custa caro —
#   a flag desliga TODOS os prompts de permissão.
#
# Fluxo ponta-a-ponta:
#   1. claude-yolo [args do claude...]     # ex: claude-yolo --model opus
#   2. abre a sessão Claude já em modo skip-permissions.
#   3. encerre como qualquer sessão claude (/exit ou Ctrl-D).
#
# Resolução do binário (cat-9 b8): via ssh não-login o PATH é básico, sem
#   ~/.local/bin → `claude` daria 127. Cadeia de resolução: seam CY_CLAUDE →
#   `command -v claude` → fallback explícito $HOME/.local/bin/claude.
#
# Seam de teste: CY_CLAUDE sobrescreve o binário resolvido (stub no teste).

set -u

if [ -n "${CY_CLAUDE:-}" ]; then
  CLAUDE="$CY_CLAUDE"
elif command -v claude >/dev/null 2>&1; then
  CLAUDE="claude"
else
  CLAUDE="$HOME/.local/bin/claude"
fi

exec "$CLAUDE" --dangerously-skip-permissions "$@"
